# macOS
.DS_Store

# Build artifacts
macos/display-probe
macos/event-watch
macos/intel-ddc-probe

# A mutation run's in-flight backup. tests/run.sh refuses to run while one
# exists, and tests/mutate.sh restores strays on startup -- but one must never
# be committed, because the file beside it is a deliberately broken copy.
*.mutbak
*.o
*.dSYM/

# Session-scoped working notes (disposable by convention)
.context/

# One-off or sensitive research never enters git; distil it into a decision record
docs/research/private/

# Logs, editors, desktop litter
*.log
*.log.1
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Windows build output
windows/**/bin/
windows/**/obj/

# Stray probe output. `nvapi-probe.ps1 TEST` writes one of these when it is used
# as the pause-and-fire target, and one got committed once.
windows/TEST
